# Update mirror list
update_mirrors() {
	curl -fsL "https://archlinux.org/mirrorlist/?country=FR&country=GB&protocol=https&use_mirror_status=on" | sed -e 's/^#Server/Server/' -e '/^#/d' | rankmirrors -n 5 -
}

# Launch steam with preloaded libs
rsteam() {
	mkdir -p /tmp/dumps
	env LD_PRELOAD="/usr/lib/libgio-2.0.so.0 /usr/lib/libglib-2.0.so.0" steam-native > /tmp/dumps/steam_stdout.txt 2> /tmp/dumps/steam_errout.txt &
}

#
# Start up programs
#

# ssh-agent: reuse the agent recorded in ~/.ssh/environment, else start one.
# Arch-only because macOS already runs one per login via launchd.
# Interactive shells only -- non-interactive ones (scp, rsync, `zsh -c`)
# don't need an agent, and any output from them corrupts scp/rsync.
SSH_ENV="$HOME/.ssh/environment"
[ -r "$SSH_ENV" ] && . "$SSH_ENV" > /dev/null
case "$(ps -p "${SSH_AGENT_PID:-0}" -o comm= 2>/dev/null)" in
    *ssh-agent) ;;
    *)
        [ -d "$HOME/.ssh" ] || mkdir -m 700 "$HOME/.ssh"
        (umask 077; ssh-agent | sed 's/^echo/#echo/' > "$SSH_ENV")
        . "$SSH_ENV" > /dev/null
        ssh-add
        ;;
esac
unset SSH_ENV
