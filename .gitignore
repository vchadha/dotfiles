.DS_Store

# The local shell layer holds secrets and lives only in ~, never in a package.
# Ignored in case one gets created here by mistake.
/*/.shell/local/
/*/.zsh/local/

# Credentials, as a failsafe: none of these belong in a package, but moving a
# whole config folder in (say ~/.config/gh) would drag them along. A pattern
# with a slash in the middle only matches from the repo root, hence the **/.
# `git add -f` still gets past any of these on purpose.

# SSH: keys, known hosts, agent state. Only the config is safe to track.
**/.ssh/*
!**/.ssh/config

# Claude Code: transcripts, memory, and on Linux the login token. Only the
# instructions file is safe to track.
**/.claude/*
!**/.claude/CLAUDE.md

# GPG and pass
**/.gnupg/
**/.password-store/

# Tokens written by CLIs and package managers
**/.config/gh/hosts.yml
**/.aws/credentials
**/.aws/sso/cache/
**/.aws/cli/cache/
**/.config/gcloud/
**/.azure/
**/.kube/config
**/.docker/config.json
**/.terraform.d/credentials.tfrc.json
**/.cargo/credentials.toml
**/.gem/credentials
.netrc
.git-credentials
.npmrc
.pypirc

# Env files and key material
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Shell and REPL history -- anything ever typed or pasted, tokens included
.*_history
.lesshst
.viminfo
