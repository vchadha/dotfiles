# Files that usually hold secrets. None belong in a package, but moving a
# whole config folder in (say ~/.config/gh) would drag them along. A pattern
# with a slash in the middle only matches from the repo root, hence the **/.
#
# `git add -f` gets past these, so hooks/pre-commit refuses to commit any
# file that matches them (plus anything shaped like a key or token).

# The local shell layer, which holds this machine's secrets
/*/.shell/local/
/*/.zsh/local/

# SSH: keys, known hosts, agent state. Only the config is safe.
**/.ssh/*
!**/.ssh/config

# Claude Code: transcripts, memory, account details. Only CLAUDE.md is safe.
**/.claude/*
!**/.claude/CLAUDE.md
.claude.json*

# GPG and pass
**/.gnupg/
**/.password-store/

# Tokens written by CLIs and package managers
**/.config/gh/hosts.yml
**/.aws/credentials
**/.aws/sso/cache/
**/.aws/cli/cache/
**/.config/gcloud/
**/.azure/
**/.kube/config
**/.docker/config.json
**/.terraform.d/credentials.tfrc.json
**/.cargo/credentials.toml
**/.gem/credentials
.netrc
.git-credentials
.npmrc
.pypirc

# Env files and key material
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx

# Shell and REPL history: anything ever typed or pasted, tokens included
.*_history
.lesshst
.viminfo

# Finder litter
.DS_Store
