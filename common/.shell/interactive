#
# Aliases
#

# Set alias for ls with color
alias ls='ls --color=auto'

#
# Functions
#

# Grep files whose name matches a glob: lookup '*.js' pattern
lookup() {
    find . -name "$1" -type f -exec grep -Hn "$2" {} +
}

# Create temp scratch dir
function scratch() {
    local SCRATCH=$(mktemp -d)
    echo 'Spawning subshell in scratch directory:'
    echo "  $SCRATCH"
    (cd $SCRATCH; zsh)
    echo "Removing scratch directory"
    rm -rf "$SCRATCH"
}

# git for the dotfiles repo, wherever it's cloned: ~/.zshrc is a stow
# symlink to <repo>/common/.zshrc, so follow it back. `dots install ...`
# runs the repo's install.sh instead (git has no `install` command to shadow).
dots() {
    local repo
    repo=$(realpath "$(dirname "$(realpath "$HOME/.zshrc")")/..")
    if [ ! -x "$repo/install.sh" ]; then
        echo "dots: ~/.zshrc isn't linked into the repo, so it can't be found; run ./install.sh from your clone" >&2
        return 1
    fi
    if [ "$1" = install ]; then
        shift
        "$repo/install.sh" "$@"
    elif [ "$1" = pull ] && [ -n "$(git -C "$repo" ls-files --others --ignored --exclude-standard -- ':!*.DS_Store')" ]; then
        # git overwrites ignored files without asking, and a new file in a
        # package stays ignored until it's added. pull has no flag against
        # that, so refuse; a plain `git pull` or rebase in the repo isn't
        # covered.
        echo "dots: commit these or move them out of the repo first; a pull could overwrite them:" >&2
        git -C "$repo" ls-files --others --ignored --exclude-standard -- ':!*.DS_Store' | sed 's/^/  /' >&2
        return 1
    elif [ "$1" = checkout ] || [ "$1" = switch ] || [ "$1" = merge ]; then
        # These do have the flag
        local cmd=$1
        shift
        git -C "$repo" "$cmd" --no-overwrite-ignore "$@"
    else
        git -C "$repo" "$@"
    fi
}

#
# Machine overlays
#

# Most general first: os/ and host/ come from the stow packages a profile
# installs; local/ is never tracked (secrets, one-off tweaks). Last so they
# can override anything above.
for __layer in os host local; do
    if [ -r "$HOME/.shell/$__layer/interactive" ]; then
        . "$HOME/.shell/$__layer/interactive"
    fi
done
unset __layer

