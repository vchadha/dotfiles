# Set env

# Here rather than in .zshrc so bash and non-interactive shells (scripts,
# `ssh host cmd`) get them too. Before the overlays, so a machine can
# override them.
export LANG=en_US.UTF-8
export EDITOR=vim

# Where uv (Pythons, `uv tool install`) and pip --user put commands. Here so
# scripts, cron and `ssh host cmd` find them too, not just terminals. Appended,
# so it adds commands without shadowing Homebrew's or the system's. The case
# keeps a shell started from another one from adding it twice (zsh dedupes
# anyway; bash and sh don't).
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$PATH:$HOME/.local/bin" ;;
esac

# Machine overlays -- same layering as .shell/interactive. Runs for every
# shell, including non-interactive ones, so overlays must stay silent.
for __layer in os host local; do
    if [ -r "$HOME/.shell/$__layer/env" ]; then
        . "$HOME/.shell/$__layer/env"
    fi
done
unset __layer
