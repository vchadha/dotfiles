# Set env

# Here rather than in .zshrc so bash and non-interactive shells (scripts,
# `ssh host cmd`) get them too. Before the overlays, so a machine can
# override them.
export LANG=en_US.UTF-8
export EDITOR=vim

# PATH entries belong in env files, not interactive ones, so scripts, cron
# and `ssh host cmd` see them too. A shell started from another one runs this
# file again, so neither helper adds a folder twice.

# An empty entry in PATH means the current folder, so refuse to add one
__require_folder() {
    [ -n "$2" ] || { echo "$1: no folder given" >&2; return 1; }
}

# Add a folder to the end of PATH, unless it's already there
append_path() {
    __require_folder append_path "$1" || return
    case ":$PATH:" in
        *":$1:"*) ;;
        *) PATH="${PATH:+$PATH:}$1" ;;
    esac
}

# Put a folder first in PATH, moving it if it's already there
prepend_path() {
    __require_folder prepend_path "$1" || return
    __path=":$PATH:"
    while case $__path in *":$1:"*) true ;; *) false ;; esac; do
        __path="${__path%%:"$1":*}:${__path#*:"$1":}"
    done
    __path=${__path#:}
    __path=${__path%:}
    PATH="$1${__path:+:$__path}"
    unset __path
}

# Where uv (Pythons, `uv tool install`) and pip --user put commands. At the
# end, so it adds commands without overriding Homebrew's or the system's.
append_path "$HOME/.local/bin"

# Machine overlays -- same layering as .shell/interactive. Runs for every
# shell, including non-interactive ones, so overlays must stay silent.
for __layer in os host local; do
    if [ -r "$HOME/.shell/$__layer/env" ]; then
        . "$HOME/.shell/$__layer/env"
    fi
done
unset __layer
