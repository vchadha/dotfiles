# A shell started from another shell runs env again on top of the PATH it
# inherited; this drops the repeats. PATH needs it as well as path, because
# brew shellenv assigns the string form.
typeset -U PATH path fpath

# Source shell env
source $HOME/.shell/env

# zsh-only overlays (e.g. fpath entries, which must exist before compinit
# runs in .zshrc)
for __layer in os host local; do
    [[ -r $HOME/.zsh/$__layer/env ]] && source $HOME/.zsh/$__layer/env
done
unset __layer
