# Paths that usually hold secrets, in .gitignore syntax. Not a .gitignore:
# hooks/pre-commit refuses to commit them (and lint checks nothing tracked
# matches), and install.sh warns about them instead of suggesting an add.

# The local shell layer, which holds this machine's secrets
/*/.shell/local/
/*/.zsh/local/

# SSH: keys, known hosts, agent state. Only the config is safe.
**/.ssh/*
!**/.ssh/config

# Claude Code: transcripts, memory, account details. Only CLAUDE.md is safe.
**/.claude/*
!**/.claude/CLAUDE.md
.claude.json*

# GPG and pass
**/.gnupg/
**/.password-store/

# Tokens written by CLIs and package managers
**/.config/gh/hosts.yml
**/.aws/credentials
**/.aws/sso/cache/
**/.aws/cli/cache/
**/.config/gcloud/
**/.azure/
**/.kube/config
**/.docker/config.json
**/.terraform.d/credentials.tfrc.json
**/.cargo/credentials.toml
**/.gem/credentials
.netrc
.git-credentials
.npmrc
.pypirc

# Env files and key material
.env
.env.*
.envrc
*.pem
*.key
*.p12
*.pfx

# Shell and REPL history: anything ever typed or pasted, tokens included
.*_history
.lesshst
.viminfo
