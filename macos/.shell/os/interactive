#
# Functions
#

# Open the current repo's remote in the browser (default remote: origin)
og() {
    local remote url
    git remote -v | grep push
    remote=${1:-origin}
    echo "Using remote $remote"
    url=$(git config "remote.$remote.url") || { echo "no remote named $remote" >&2; return 1; }
    url=$(echo "$url" | sed "s/git@\(.*\):\(.*\).git/https:\/\/\1\/\2/")
    echo "Opening $url ..."
    open "$url"
}

#
# Paths
#

# VS Code's `code` CLI
append_path "/Applications/Visual Studio Code.app/Contents/Resources/app/bin"

# .NET Core SDK tools
append_path "$HOME/.dotnet/tools"

#
# Tool managers
#

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && . "$NVM_DIR/bash_completion"

# SDKMAN wants to be last so nothing prepends over its PATH entries
export SDKMAN_DIR="$HOME/.sdkman"
[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ] && . "$SDKMAN_DIR/bin/sdkman-init.sh"
